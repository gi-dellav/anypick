{
  "name": "anypick-ts",
  "version": "0.1.0",
  "description": "Select LLMs using filters across capabilities, prices and benchmarks",
  "license": "MIT",
  "author": "Giuseppe Della Vedova",
  "homepage": "https://github.com/gi-dellav/anypick",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gi-dellav/anypick.git"
  },
  "bugs": {
    "url": "https://github.com/gi-dellav/anypick/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "anypick": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "llm",
    "model-selection",
    "openrouter",
    "vercel",
    "benchmarks"
  ],
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  }
}
